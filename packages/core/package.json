{
  "name": "@bwo-ui/core",
  "version": "0.7.1",
  "description": "Framework-agnostic motion engine behind @bwo-ui/{react,vue,svelte}. Ships GSAP-backed factories for every primitive owned end-to-end — Tilt, Ripple, Pulse, Spin, Parallax, ScrollReveal, ScrollMask, ScrollVelocity, ScrollSnap, ScrollProgress, CircleReveal, SplitReveal, Marquee, FlipList, Magnetic, Spotlight, Typewriter, TextDecode, Confetti, Shake — plus tokens + base CSS. Live demos & docs at https://ui.boogie.ro.",
  "license": "MIT",
  "author": "BOOGIE WOOGIE S.R.L. <contact@boogie.ro>",
  "homepage": "https://github.com/BoogieCode/bwo-ui/tree/master/packages/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoogieCode/bwo-ui.git",
    "directory": "packages/core"
  },
  "keywords": [
    "gsap",
    "animation",
    "motion",
    "scroll",
    "scroll-trigger",
    "parallax",
    "tilt",
    "marquee",
    "magnetic",
    "splittext",
    "design-system",
    "tokens",
    "bwo-ui"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles/index.css",
    "./styles/*": "./styles/*"
  },
  "files": [
    "dist",
    "styles",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "gsap": ">=3.12.0"
  },
  "devDependencies": {
    "gsap": "^3.12.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "rimraf": "^6.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
