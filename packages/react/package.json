{
  "name": "@bwo-ui/react",
  "version": "0.6.0",
  "description": "70+ motion-first React 18 components, owned end-to-end. Every primitive — Dialog, Popover, Combobox, DataTable, Calendar, Toast — written in-house, no headless library underneath. Ships GSAP-backed motion (Tilt, Ripple, Pulse, ScrollReveal, ScrollMask, ScrollVelocity, Parallax, SplitReveal, Marquee) out of the box. Theme via 40+ CSS custom properties, opt-in dark mode, zero runtime dependencies (GSAP is a peer). Live demos at https://ui.boogie.ro.",
  "license": "MIT",
  "author": "BOOGIE WOOGIE S.R.L. <contact@boogie.ro>",
  "homepage": "https://github.com/BoogieCode/bwo-ui/tree/master/packages/react",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoogieCode/bwo-ui.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "react-18",
    "react-19",
    "components",
    "ui",
    "ui-kit",
    "design-system",
    "headless",
    "accessible",
    "gsap",
    "animation",
    "motion",
    "scroll",
    "scroll-trigger",
    "parallax",
    "tilt",
    "ripple",
    "marquee",
    "magnetic",
    "splittext",
    "dialog",
    "popover",
    "combobox",
    "data-table",
    "calendar",
    "toast",
    "tokens",
    "dark-mode",
    "bwo-ui"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@bwo-ui/core": "workspace:*"
  },
  "peerDependencies": {
    "gsap": ">=3.12.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "rimraf": "^6.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
