{
  "name": "@bwo-ui/svelte",
  "version": "0.7.0",
  "description": "100+ motion-first Svelte 5 components and actions, owned end-to-end. Same primitives as @bwo-ui/{react,vue} — written in-house, no headless library underneath. GSAP-backed motion (tilt, ripple, pulse, circleReveal, scrollReveal, scrollMask, scrollVelocity, parallax, splitReveal, textDecode, confetti, shake) exposed as Svelte actions you compose with use:. Zero runtime dependencies (GSAP is a peer). Live demos at https://ui.boogie.ro.",
  "license": "MIT",
  "author": "BOOGIE WOOGIE S.R.L. <contact@boogie.ro>",
  "homepage": "https://github.com/BoogieCode/bwo-ui/tree/master/packages/svelte",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoogieCode/bwo-ui.git",
    "directory": "packages/svelte"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "components",
    "ui",
    "ui-kit",
    "design-system",
    "headless",
    "accessible",
    "actions",
    "gsap",
    "animation",
    "motion",
    "scroll",
    "scroll-trigger",
    "parallax",
    "tilt",
    "ripple",
    "marquee",
    "magnetic",
    "splittext",
    "tokens",
    "dark-mode",
    "bwo-ui"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@bwo-ui/core": "workspace:*"
  },
  "peerDependencies": {
    "gsap": ">=3.12.0",
    "svelte": ">=4.0.0"
  },
  "devDependencies": {
    "gsap": "^3.12.5",
    "svelte": "^5.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "rimraf": "^6.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
